    "eslint": "^10.8.1",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
