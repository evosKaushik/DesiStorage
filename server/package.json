  "type": "module",
  "main": "app.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test \"tests/unit/**/*.test.ts\" \"tests/integration/**/*.test.ts\"",
    "test:unit": "tsx --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "tsx --test --test-concurrency=1 \"tests/integration/**/*.test.ts\"",
    "test:coverage": "tsx --test --experimental-test-coverage \"tests/unit/**/*.test.ts\" \"tests/integration/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/sensible": "^6.0.5",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "geoip-lite": "^2.0.3",
    "google-auth-library": "^11.0.2",
    "mongoose": "^9.9.2",
    "pino-pretty": "^13.1.3",
    "redis": "^6.2.1",
    "resend": "^6.21.0",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^26.2.0",
